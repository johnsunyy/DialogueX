# ============================================================
# DIALOGUE-X  –  Environment Variable Template
# ============================================================
# Copy this file to .env and fill in your real values.
#   cp .env.example .env
#
# IMPORTANT: .env is listed in .gitignore and must NEVER be
# committed to version control.
# ============================================================

# ── Flask / Backend ──────────────────────────────────────────
# Generate a strong random key with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string

# ── Agora (WebRTC) ───────────────────────────────────────────
# Get your App ID from https://console.agora.io
AGORA_APP_ID=YOUR_AGORA_APP_ID

# ── Backend URL (used by the frontend) ───────────────────────
# Local development:  http://localhost:5000
# LAN / production:   http://<your-server-ip>:5000
BACKEND_URL=http://localhost:5000
